# Contact form delivery (server-side only — never prefix these with NEXT_PUBLIC_).
# Create a key at https://resend.com/api-keys and add the same variables in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=

# Optional. Sender shown in the inbox. Until a domain is verified in Resend, leave empty to use
# Resend's shared test sender (delivers only to the Resend account owner's address).
CONTACT_FROM_EMAIL=

# Optional. Overrides siteConfig.contactEmail as the destination inbox.
CONTACT_TO_EMAIL=
